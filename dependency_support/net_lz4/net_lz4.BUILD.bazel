load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(
    name = "src",
    srcs = [
        "lib/lz4.c",
        "lib/lz4.h",
        "lib/lz4file.c",
        "lib/lz4file.h",
        "lib/lz4frame.c",
        "lib/lz4frame.h",
        "lib/lz4frame_static.h",
        "lib/lz4hc.c",
        "lib/lz4hc.h",
        "lib/xxhash.c",
        "lib/xxhash.h",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "lz4",
    srcs = [":src"],
    hdrs = [":src"],
    strip_include_prefix = "lib",
    visibility = ["//visibility:public"],
)
